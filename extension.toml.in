# Control-plane extension manifest — the UNRENDERED source.
#
# This file is not installable as-is. `scripts/install-extension.sh` renders it
# to a gitignored `extension.toml`, substituting `__REPO_PATH__` with the
# absolute path of your clone, then installs that:
#
#     ./scripts/install-extension.sh
#
# WHY THE PLACEHOLDER EXISTS — do not "simplify" it back to `~/...`.
#
# `[[sessions]] repo_path` must be an ABSOLUTE path, and two things keep it that
# way — one historical, one permanent.
#
# Historically, thurbox did not expand a leading tilde there:
# `ExtensionDef::resolved_for_home()` substituted the `{home}` token but never
# called `expand_tilde`, so `~/code/control-plane` was taken literally and the
# session opened a directory whose name is the single character `~`. That bug is
# fixed — Thurbeen/thurbox#782, first shipped in 0.174.2 — and since
# `min_thurbox_version` below is now 2.19.0, no supported thurbox still has it.
# The history is kept because it is why the placeholder was introduced, not
# because it still bites.
#
# Permanently, and independently of that bug: no token spells "my clone".
# `{home}` is substituted — but it resolves to the extension home
# (`~/.config/thurbox/extensions/fleet`), not to your checkout. The session must
# open the checkout, because it needs `registry/` and `orchestration/` in hand.
#
# A committed file cannot hardcode a path that exists on exactly one machine.
# Hence `__REPO_PATH__`, rendered at install time.
#
# AND RENDERING IT AGAIN IS NOT ENOUGH IF THE CLONE MOVED. thurbox's
# `ensure_extension` finds an extension's session by NAME and reuses the one it
# finds; it never compares that session's directory against the manifest's. So a
# re-install rewrites this file, reports success, and leaves the live session
# opening the OLD path — with `extension status` still calling it healthy.
# `scripts/install-extension.sh` closes that gap itself: it compares the live
# session's cwd against this clone and exits non-zero naming the remedy
# (`extension deactivate`, which deletes the session, then re-install).
#
# thurbox lays down the [[files]] / [[symlinks]] under `home`, registers the
# [[agents]] in agents.toml (existing entries are kept), then activates the
# [[sessions]] and self-heals it if it is ever deleted. Turn it off with
# `thurbox-cli extension deactivate fleet`.
#
# WHAT THIS MANIFEST DELIBERATELY LEAVES OUT. thurbox's manifest format offers
# more than fleet uses; each omission below is a decision, not an oversight.
#
#   [[automations]]   No scheduled resource, in either flavour. The `send` one
#                     (session_ref + prompt) and the headless `exec` one
#                     (command) would both fit the registry sync — and the sync
#                     commits and pushes to `main`, so it stays a manual
#                     `./scripts/sync-registry.sh` run by a human who can read
#                     the diff.
#   [[external_files]]
#   [[agent_patches]]
#   [[config_merges]] The three payload kinds that reach OUTSIDE the extension
#                     home, into an agent's own config. They exist so a hook or
#                     skill can reach a CLI that has no launch flag. fleet ships
#                     neither: its skills live in the checkout under
#                     `.agents/skills/`, where the session already reads them.
#                     A control plane should not edit your agent's global config.
#
#                     THE TUI QUEUE PANE DID NOT CHANGE THIS, and it is the
#                     obvious candidate that would. `interface/fleet_queue.lua`
#                     has to land in the thurbox INTERFACE directory, outside
#                     this extension's home, and `[[external_files]]` is exactly
#                     the payload kind that puts a file there. It still goes
#                     through `thurbox-cli plugin install`, called from
#                     `scripts/install-extension.sh`, for three reasons a
#                     manifest payload cannot match:
#
#                       * It is RECORDED. The pane is written into the user's
#                         `plugins.toml`, so `plugin list` says where it came
#                         from and `plugin remove` takes back the file, the spec
#                         entry and the lock. An external file is copied once and
#                         belongs to nobody afterwards.
#                       * It is the mechanism thurbox INTENDS for a pane, and the
#                         only one that prints the `layout.lua` block the pane
#                         needs in order to be placed. A pane that is laid down
#                         silently loads, appears in `plugin list`, and draws
#                         nothing — which is the failure mode with no symptom.
#                       * `plugin sync` keeps it in step afterwards, and a copy
#                         the user edited is reported `kept` rather than
#                         overwritten.
#
#                     So the stance holds unchanged: nothing in THIS FILE reaches
#                     outside the extension home. The pane is installed by a
#                     script, through thurbox's own front door for panes, and
#                     placing it stays the user's own edit — see
#                     `scripts/install-extension.sh`.
#   home / --home     Omitted, so the home defaults to
#                     `<config>/extensions/fleet`. Do NOT "fix" the placeholder
#                     by installing with `--home <your clone>`: that would make
#                     `{home}` the checkout, lay this extension's payload and
#                     symlinks into your working tree, and — because
#                     `uninstall --purge` only refuses paths shallower than two
#                     components or `$HOME` itself — let a purge delete the
#                     clone.
#   [[files]] flags   `executable`, `if_absent` and `substitute` all go unused:
#                     the single payload file is prose, is not a user-edited
#                     seed, and contains no `{home}` to substitute.

# RENAMING — the SESSION and the EXTENSION are two names, not one. They were
# the same word (`fleet`) until the lead was renamed, which is what made them
# look like one name in six places. They are not:
#
#   the session   `<glyph> Mission Control`
#                                      what the TUI lists and what the mailbox
#                                      addresses. The GLYPH is a setting and
#                                      the rest is the name — see the glyph
#                                      header below
#   the extension `fleet`              the id every `thurbox-cli extension ...`
#                                      command takes, the directory it derives
#                                      and the directory it derives
#                                      (`~/.config/thurbox/extensions/fleet`).
#                                      It registers no agent — see the
#                                      no-[[agents]] note further down
#
# The extension keeps the REPO's name because it IS this repo's packaging, and
# nothing reads the repo name — a clone checked out as `mission-control` still
# installs an extension called `fleet`. That split is also what keeps
# `thurbox-cli extension status fleet` the right question to ask AFTER a
# session rename, which is the one thing a rename used to break.
#
# THE GLYPH IS PART OF THE NAME, because thurbox has no field for it. Its
# `ExtensionSession` carries `name`, `agent` and `repo_path` and nothing else,
# and `session create` has no icon flag — so a lead that wants a mark in the
# session list can only wear it in its name.
#
# WHICH MARK IS A SETTING, AND `__LEAD_GLYPH__` IN THE TABLE BELOW IS WHERE IT
# ARRIVES.
# `orchestration/session-glyphs.example.conf` is the one place it is chosen —
# `GLYPHS=on` for `📡` (the default), `GLYPHS=off` for `⌖` — and
# `scripts/install-extension.sh` substitutes it into the rendered manifest the
# same way it substitutes `__REPO_PATH__`. That file's header owns the whole
# argument; two things about it belong here, where the name is:
#
#   * `📡` is U+1F4E1, East_Asian_Width WIDE: TWO cells in the tmux grid the TUI
#     draws on. `⌖` is U+2316 POSITION MARKER, Neutral, so one cell and not an
#     emoji. That is the entire difference between the two values, and the
#     reason `off` is a real setting rather than a relic.
#   * Neither needs a variation selector or a colour font. A selector would add
#     a character some terminals count as a column and others do not, and every
#     column after the name would shear.
#
# SO THE MAILBOX ADDRESS IS NO LONGER TYPEABLE, and that is the cost, at either
# setting. Neither glyph is on a keyboard, so `--to '<glyph> Mission Control'`
# has to be COPY-PASTED — and the honest place to copy it from is
# `thurbox-cli session list`, which shows the name the session was actually
# SPAWNED with. This file shows what the next spawn will use, which is not the
# same claim while a rename is un-applied. Quote it either way: the name has a
# space, and unquoted the shell splits it. Anything addressed to a hand-typed
# `Mission Control` finds no session at all.
#
# WHERE THE FULL LITERAL GOES, AND WHERE IT DOES NOT — and after the glyph
# became a setting the answer is "almost nowhere". The rendered manifest is the
# only file that spells the whole name, because it is the only one that decides
# what thurbox spawns. Everything else names the lead the way prose always
# did — Mission Control, no backticks, no glyph — or resolves the real string at
# the moment it needs it, out of this manifest or out of `session list`. A
# backtick here means "this is the literal thing", and a literal that hardcodes
# one setting's value is a lie the moment the setting moves.
#
# RENAMING THE SESSION AGAIN — the NAME, not the glyph. It is in two places now
# and they move together:
#
#   [[sessions]] name                (1) here — the only place that decides
#                                        what thurbox spawns
#   interface/fleet_queue.lua        (2) CONTROL_PLANE: the TUI pane probes the
#                                        lead to find the checkout. It holds
#                                        the name WITHOUT the glyph and accepts
#                                        either mark in front of it, so the
#                                        setting never reaches it — but the
#                                        words still have to agree
#
# Two more places move with them without being one of the two:
# `scripts/queue-selftest.sh` asserts that (1) rendered ends in (2), and
# `scripts/check.sh pane` asserts the same of the unrendered file, so the gate
# fails a rename that stops at either. FLEET.md names the lead in prose and
# carries no literal to update.
#
# A PARTIAL RENAME is the failure mode: change (1) alone and thurbox spawns the
# new name while the pane goes on probing the old one, so the queue pane says
# "no session" forever, and anything still addressed to the old name either
# bounces or lands in an inbox nobody drains. The GLYPH can no longer cause
# that — nothing but the manifest carries it — which is what made it safe to
# put a two-cell emoji there at all.
#
# AND EDITING THIS FILE IS NOT THE RENAME — NOR IS FLIPPING THE GLYPH SETTING,
# which is the same operation wearing a smaller word. thurbox names a session
# when it SPAWNS it and has no verb that renames one afterwards (`session
# --help` lists none), while `ensure_extension` matches a declared session to a
# live one by NAME — so installing a new name simply spawns a SECOND session and
# orphans the first, with `extension status` calling that healthy. A glyph the
# operator changed and did not apply costs exactly this, because `📡 Mission
# Control` and `⌖ Mission Control` are two names to everything that resolves
# one. Both sequences below leave exactly one session, under the new name. They
# differ in what they cost.
#
#   KEEPING THE CONVERSATION. `fork` continues it, because the stock `claude`
#   agent this session binds to declares `fork_args`:
#
#     1. git pull                                   # the new name, on disk
#     2. thurbox-cli session fork '<old>' --name '<new>'
#     3. ./scripts/install-extension.sh             # adopts the session that
#                                                   # already answers to <new>
#     4. thurbox-cli session delete '<old>' --force
#     5. thurbox-cli extension status fleet         # unchanged — the extension
#                                                   # id did not move
#
#     Step 4 must come AFTER step 3: until the new manifest is installed the
#     extension still declares <old>, and self-heal spawns it straight back.
#
#   DISCARDING IT — fewer moving parts, and THE LEAD'S HISTORY IS GONE:
#
#     1. thurbox-cli extension deactivate fleet     # deletes the <old> session
#     2. git pull
#     3. ./scripts/install-extension.sh             # spawns <new>
#
#     Step 1 must come FIRST. `deactivate` tears down the sessions the
#     INSTALLED manifest declares, so run it after the rename is installed and
#     it looks for <new>, finds nothing, and leaves <old> running forever.
#
# RENAMING THE EXTENSION is a different, heavier operation that none of the
# above needs: change the top-level `name`, then `thurbox-cli extension
# uninstall fleet` BEFORE installing. `[[sessions]] agent` is not part of it —
# it names the stock `claude` agent, which is thurbox's and not this
# extension's to rename. Skip that uninstall and you get two registered
# extensions and two self-healing sessions, each recreating itself, plus an
# orphaned `~/.config/thurbox/extensions/fleet/`.
#
# FLEET.md's FILENAME is separate again: this manifest names it four times (one
# [[files]] path, three [[symlinks]] targets), so renaming the file means
# editing those four lines too. Neither rename above requires it.
#
# WORKER session names are in none of this. They are free-form strings that
# nothing resolves — by the convention in orchestration/playbooks/ each is an
# imperative sentence describing the work, with no `fleet` prefix and no repo
# prefix. They wear `🚀` under the SAME setting as the lead's mark (`GLYPHS=on`
# in `orchestration/session-glyphs.example.conf`), applied by
# `scripts/lib/queue.py` where the name is built at dispatch — and because
# nothing resolves those names, that half cost none of the argument above.
# Existing workers keep the name they were spawned with: there is no rename
# verb for them either, and none of the sequences above is worth running on a
# session that will be reaped when its pull request merges.

name = "fleet"
description = "Control-plane session: the repo map and thurbox orchestration"
config_version = 1
version = "1.2.0"                # this extension's own version; bump on changes

# WHY THE FLOOR IS 2.19.0 — it is a claim about what this control plane's own
# prose relies on, not a note about the version somebody happens to run.
#
# 0.113.0 bought the `extension install` / self-heal machinery this manifest
# needs, and for a long time that was the whole requirement. What raised it is
# the session-state vocabulary the repo now documents and reads:
#
#   2.13.4  `session get`/`list --json` publish a single `state` word, and the
#           words are honest: `running`, `uncovered` and `unreported` are
#           spelled apart from `idle`, so `idle` means the agent SAID it is at
#           rest rather than "nothing here reports anything" (thurbox#1064).
#           `.agents/skills/thurbox-session/SKILL.md` documents that table and
#           tells an agent to read the word rather than the absence of one; on
#           an older thurbox it would be reading a field that is not there.
#   2.18.3  `detected_agent`, and `session get` stops answering `idle` for a
#           session an outside harness launched an agent into (thurbox#1081).
#           That fix is tagged v2.18.3, but the tag was never published as a
#           release — nobody runs it standalone. It reached users bundled into
#           2.19.0, alongside #1082. This control plane's own lead session is
#           exactly the shape #1081 fixes, so the fix is not academic here.
#   2.19.0  hook coverage for `grok` and `kimi` alongside the agents already
#           covered (thurbox#1082). This matters because `[[sessions]] agent`
#           below is swappable — a control plane that invites you to point the
#           lead at another CLI should be honest about which agents can report
#           a state at all.
#
# Deliberately NOT required: the printing-vs-holding-a-pane distinction
# (`thurbox.printing`, 2.19.2). It is what lets the TUI animate a `running`
# spinner only on evidence, and it reaches Lua rather than the CLI — nothing
# this repo reads is behind it, so it would be a floor bought for nothing.
min_thurbox_version = "2.19.0"
# No `home`: defaults to `<config>/extensions/fleet` (override with --home).

# --- no [[agents]] block: the lead runs the stock `claude` agent ---------------
#
# There used to be one here, named `fleet`, and it existed only to pin a model:
# `args = ["--model", "claude-opus-4-8"]`. Everything else in it —
# `resume_args`, `fork_args`, `new_session_args` — was copied from the stock
# `claude` entry verbatim, so the whole block bought one flag and maintained a
# parallel copy of thurbox's own definition to hold it.
#
# `args` REPLACES the stock agent's args; it does not add to them. The stock
# `claude` entry carries `--settings <config>/hooks/claude.json`, which is how
# the built-in `hooks` extension makes an agent report `working`, `blocked`,
# `done` and `idle` back to thurbox. Pinning a model there dropped that file,
# and a lead that reports no state is one `queue.sh watch`, `reap` and
# `refuel` all read wrong — `refuel` in particular treats a stale `working`
# as a wedged session.
#
# The live lead never hit it: it was created before the block was bound and
# still runs `agent = "claude"` with `hook_coverage: full`. The bug was latent,
# waiting for the next `extension deactivate` + install to recreate the session.
#
# So: no agent is registered, the session binds to `claude` below, and the model
# is whatever `claude` defaults to. To pin one anyway, add the block back with
# BOTH flags — the settings path and the model — or set the model in
# `~/.claude/settings.json`, which needs no block at all.

# --- payload files laid down under home ---------------------------------------
#
# Only the standing context ships. The registry, playbooks and run logs stay in
# the git checkout — they are versioned there, and `repos.generated.yaml` is
# generated, so shipping a copy would immediately drift.

[[files]]
path = "FLEET.md"

# --- context-file symlinks: surface FLEET.md to each CLI's convention ---------

[[symlinks]]
link = "CLAUDE.md"
target = "FLEET.md"

[[symlinks]]
link = "AGENTS.md"
target = "FLEET.md"

[[symlinks]]
link = "GEMINI.md"
target = "FLEET.md"

# --- runtime resources: ensured on activate, self-healed if deleted -----------
#
# A single long-lived session, so the control plane is always there to plan a
# run, hold the log, and receive worker mail (`message send --to '<the name
# below, rendered>'`) — which needs the lead to *be* a session, not an ad-hoc
# terminal. Paste that address out of `thurbox-cli session list`; no glyph is on
# a keyboard, and the live session is the one that answers. See the glyph and
# RENAMING headers.

[[sessions]]
name = "__LEAD_GLYPH__ Mission Control"
agent = "claude"
# The session opens your checkout, not the extension home: it needs registry/
# and orchestration/ in hand, and the repo's SessionStart hook
# (.claude/settings.json) fast-forwards main before any work starts.
#
# Rendered by scripts/install-extension.sh. See the header for why this is an
# absolute path and not a `~`.
repo_path = "__REPO_PATH__"
